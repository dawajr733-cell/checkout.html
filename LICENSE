    <!-- JavaScript to handle page switching without getting 404 Error -->
    <script>
        function openCheckout(packageName) {
            // Hide the store page
            document.getElementById('store-page').style.display = 'none';
            document.getElementById('store-nav').style.display = 'none';
            
            // Show the checkout page
            document.getElementById('checkout-page').style.display = 'block';
            document.getElementById('checkout-nav').style.display = 'flex';
            
            // Set the package name in the form
            document.getElementById('packageField').value = packageName;
            
            // Scroll to the top
            window.scrollTo(0, 0);
        }

        function goBack() {
            // Hide the checkout page
            document.getElementById('checkout-page').style.display = 'none';
            document.getElementById('checkout-nav').style.display = 'none';
            
            // Show the store page
            document.getElementById('store-page').style.display = 'block';
            document.getElementById('store-nav').style.display = 'flex';
            
            // Scroll to the top
            window.scrollTo(0, 0);
        }
    </script>
